# ============================================================
# IBVAP — Environment Configuration Template
# Copy this file to .env and fill in every value marked REQUIRED.
# NEVER commit .env to version control.
# ============================================================

# --- Database (PostgreSQL required in production) ---
# D-01: SQLite is blocked when ENV=production.
DATABASE_URL=postgresql://ibvap_user:CHANGE_ME@localhost:5432/ibvap_db
POSTGRES_USER=ibvap_user
POSTGRES_PASSWORD=CHANGE_ME          # REQUIRED — min 16 random characters

# --- Redis ---
# I-02: Redis is password-protected. This password must match REDIS_URL below.
REDIS_PASSWORD=CHANGE_ME             # REQUIRED — min 16 random characters
REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# --- Authentication ---
# S-01/S-02: Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-at-least-32-random-hex-characters  # REQUIRED
ADMIN_USERNAME=configure-during-deployment                   # REQUIRED
ADMIN_PASSWORD=replace-with-at-least-12-characters          # REQUIRED

# S-02: Access token expiry (minutes). 30 min is the production default.
# Increase to 120 for field deployments with intermittent connectivity.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- AI Model ---
MODEL_PATH=models/current/ibvap_detector.pt
MODEL_SHA256=0EBBC80D4A7680D14987A577CD21342B65ECFD94632BD9A8DA63AE6417644EE1
MODEL_REGISTRY_PATH=models/model_registry.yaml

# --- API Server ---
API_PORT=8000
API_HOST=0.0.0.0

# --- Environment ---
# Set to "production" to activate all production guards (SQLite block, no /docs, etc.)
ENV=production

# --- Demo Mode (development only) ---
# Set DEMO_MODE=true only for a controlled demo environment.
# Never enable in a live border-post deployment.
DEMO_MODE=false
DEMO_USERNAME=demo_operator
DEMO_PASSWORD=replace-with-a-demo-password-of-at-least-12-characters

# --- Cookie Security ---
# true when the dashboard is served over HTTPS (always true in production)
COOKIE_SECURE=true
